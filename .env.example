MYSQL_HOST=127.0.0.1

MYSQL_PORT=3307

MYSQL_USER=root

MYSQL_PASSWORD=root123

MYSQL_DATABASE=haici_cs



CHROMA_HOST=127.0.0.1

CHROMA_PORT=8001



SECRET_KEY=change-me-to-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=1440



DAILY_QUESTION_LIMIT=100
# 管理员每日提问上限；0 表示不限次
DAILY_QUESTION_LIMIT_ADMIN=0

MAX_QUESTION_LENGTH=500
# 模型上下文窗口（字符）；历史预算 = 总值 - CHAT_CONTEXT_RESERVE_CHARS
CHAT_MAX_CONTEXT_CHARS=262144
CHAT_CONTEXT_RESERVE_CHARS=32768
CHAT_HISTORY_TURNS=50

# ── 知识库分块（对齐 web_rebuild slice_method） ──
KB_DEFAULT_SLICE_METHOD=auto
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=80
KB_CHUNK_MAX_TOKENS=350
KB_DYNAMIC_MAX_CHARS=800
KB_NORMALIZE_ENABLED=true

# ── 文档图片 OCR / VLM（SPEC-RAG文档标准化） ──
BAIDU_OCR_ENABLED=true
BAIDU_OCR_APP_ID=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
VLM_IMAGE_ENABLED=true
MAX_IMAGES_PER_DOC=30

# 反馈看板无真实数据时返回演示统计（标注 demo_mode）
FEEDBACK_DEMO_FALLBACK=true



# ── 火山方舟 ARK（OpenAI 兼容，对齐 src/agent/config.json） ──

ARK_API_KEY=your-ark-api-key

ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

LLM_MODEL_QA=ep-xxxxxxxx

LLM_MODEL_REASON=ep-yyyyyyyy



# ── 通义千问 DashScope（OpenAI 兼容，可选第二接入） ──

QWEN_API_KEY=your-dashscope-api-key

QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

QWEN_MODEL=qwen-turbo



# ── 网关路由（与 web_rebuild_v2 一致） ──

GATEWAY_PROVIDER=ark

GATEWAY_ROUTE_MODE=task_type

# 可选：合并上级 config.json 的 api_gateway_nodes 节点池

LLM_GATEWAY_CONFIG=../src/agent/config.json



# 兼容旧版单 Key（未配置 ARK/QWEN 时兜底）

LLM_API_KEY=

LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

LLM_MODEL=qwen-turbo

LLM_TIMEOUT_SECONDS=60



EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_MODEL_PATH=../src/agent/knowledge_base/models/models--BAAI--bge-large-zh-v1.5/snapshots/79e7739b6ab944e86d6171e44d24c997fc1e0116
EMBEDDING_MODEL_CACHE_DIR=../src/agent/knowledge_base/models

UPLOAD_DIR=./data/uploads

CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8010,http://127.0.0.1:5173,http://localhost:5173

